---
import { plans } from '../data/content';
import { whatsappLink } from '../config/site';
---

<section id="planes" class="bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-5 py-24">
    <p class="eyebrow mb-4 !text-paper/60" data-reveal>
      Planes
    </p>
    <h2 class="display max-w-2xl text-4xl md:text-6xl" data-reveal>
      Precio claro. <em>Sin sorpresas.</em>
    </h2>
    <div class="mt-14 grid items-stretch gap-6 md:grid-cols-3">
      {plans.map((p) => (
        <article
          class:list={[
            'flex flex-col rounded-3xl border p-8',
            p.featured
              ? 'border-vermilion bg-vermilion text-paper md:-translate-y-4'
              : 'border-paper/20',
          ]}
          data-reveal
        >
          <p class="eyebrow !text-current opacity-70">{p.note}</p>
          <h3 class="mt-3 font-serif text-3xl">{p.name}</h3>
          <p class="mt-5 font-serif text-6xl font-light">
            {p.price}
            <span class="ml-1 text-base opacity-70">MXN</span>
          </p>
          <ul class="mt-8 flex-1 space-y-3 text-sm">
            {p.features.map((f) => (
              <li class="flex gap-2">
                <span aria-hidden="true">—</span>
                {f}
              </li>
            ))}
          </ul>
          <a
            href={whatsappLink(`Hola Crecify, me interesa el plan ${p.name}.`)}
            class:list={[
              'btn mt-8',
              p.featured
                ? 'bg-ink text-paper hover:bg-paper hover:text-ink'
                : 'border border-paper/40 hover:bg-paper hover:text-ink',
            ]}
          >
            Quiero este plan
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
