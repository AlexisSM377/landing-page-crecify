---
import { whatsappLink, bookingLink } from '../config/site';
---

<section
  id="top"
  class="mx-auto grid max-w-6xl items-center gap-14 px-5 pt-16 pb-24 lg:grid-cols-[1.15fr_0.85fr] lg:pt-24"
>
  <div>
    <p class="eyebrow mb-6" data-hero>
      Presencia digital para negocios locales
    </p>
    <h1 class="display text-[clamp(2.8rem,7vw,5.6rem)] leading-[0.98]" data-hero>
      Tu negocio en internet, <em>sin complicarte</em> la vida.
    </h1>
    <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft" data-hero>
      Página web, WhatsApp, QR, horarios y Google Maps en un solo paquete. Listo en días, desde
      <strong class="font-semibold text-ink">$690</strong>.
    </p>
    <div class="mt-9 flex flex-wrap gap-3" data-hero>
      <a href={whatsappLink()} class="btn btn-primary">
        Escribir por WhatsApp
      </a>
      <a href={bookingLink} class="btn btn-ghost">
        Agendar diagnóstico
      </a>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-[320px]" data-hero aria-hidden="true">
    <div class="rounded-[2.4rem] border border-ink bg-ink p-2.5 shadow-[14px_14px_0_0_var(--color-vermilion)]">
      <div class="overflow-hidden rounded-[1.9rem] bg-paper">
        <div class="bg-ink px-5 pt-8 pb-6 text-paper">
          <p class="eyebrow !text-paper/60">Barbería</p>
          <p class="font-serif text-3xl leading-tight">
            Don Mateo <em class="text-vermilion">&amp; Co.</em>
          </p>
        </div>
        <div class="space-y-3 p-5 text-sm">
          <div class="flex justify-between border-b border-line pb-2">
            <span>Corte clásico</span>
            <b>$150</b>
          </div>
          <div class="flex justify-between border-b border-line pb-2">
            <span>Barba y toalla</span>
            <b>$120</b>
          </div>
          <div class="flex justify-between border-b border-line pb-2">
            <span>Combo completo</span>
            <b>$240</b>
          </div>
          <p class="pt-1 text-xs text-ink-soft">Lun–Sáb · 10:00 a 20:00</p>
          <div class="flex items-center gap-3 pt-2">
            <span class="btn btn-primary flex-1 !py-3 !text-xs">Reservar por WhatsApp</span>
            <svg viewBox="0 0 21 21" class="size-12 shrink-0" shape-rendering="crispEdges">
              <rect width="21" height="21" fill="#f4efe6" />
              <path
                fill="#161412"
                d="M0 0h7v7H0zM14 0h7v7h-7zM0 14h7v7H0zM2 2h3v3H2zM16 2h3v3h-3zM2 16h3v3H2zM9 1h2v2H9zM9 5h4v2H9zM8 9h3v2H8zM12 9h2v4h-2zM16 10h4v2h-4zM9 13h2v3H9zM13 15h3v2h-3zM17 14h3v3h-3zM9 18h4v2H9z"
              />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
