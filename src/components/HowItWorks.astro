---
import { steps } from '../data/content';
---

<section id="como-funciona" class="border-y border-line bg-paper-2">
  <div class="mx-auto max-w-6xl px-5 py-24">
    <p class="eyebrow mb-4" data-reveal>
      Cómo funciona
    </p>
    <h2 class="display max-w-2xl text-4xl md:text-6xl" data-reveal>
      Cuatro pasos, <em>cero</em> tecnicismos.
    </h2>
    <ol class="mt-16 grid gap-10 md:grid-cols-4">
      {steps.map((s, i) => (
        <li class="border-t border-ink pt-5" data-reveal>
          <span class="font-serif text-5xl font-light text-vermilion">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-4 text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 text-ink-soft">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
